// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Roles are stored as plain strings ("landlord", "system_admin"), not an enum,
// per CLAUDE.md RBAC notes — ROLE_GRANTS maps strings to permissions in app code.
model User {
  id        String   @id @default(cuid())
  clerkId   String?  @unique
  email     String   @unique
  name      String?
  role      String   @default("landlord")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities               Entity[]
  tenants                Tenant[]
  vendors                Vendor[]
  defaultClauseTemplates DefaultClauseTemplate[]
  maintenanceRequests    MaintenanceRequest[]
  maintenanceSchedules   MaintenanceSchedule[]
  clauses                Clause[]
}

enum EntityType {
  LLC
  S_CORP
  PERSONAL
  OTHER
}

// Every property is owned by an Entity, never directly by a User.
// "Self / Personal" (entityType = PERSONAL) is a valid entity for landlords without an LLC.
model Entity {
  id                  String     @id @default(cuid())
  userId              String
  legalName           String
  entityType          EntityType
  // The one Self / Personal entity auto-created at signup so every property
  // always has somewhere to default to. Locked from edit/delete at the app
  // layer (see entities.routes.js) — a user can still add other PERSONAL
  // entities (e.g. tracking a property they don't personally own), those
  // are ordinary editable/deletable entities with isDefault left false.
  isDefault           Boolean    @default(false)
  // Correspondence for this entity specifically — e.g. a business email for
  // an LLC, separate from the landlord's own account email/phone in Clerk.
  contactEmail        String?
  contactPhone        String?
  mailingAddress      String?
  stateOfFormation    String?
  ein                 String? // encrypted at rest at the app layer
  registeredAgent     String?
  formationDate       DateTime?
  annualReportDueDate DateTime? // reminder fires 60 days before this date
  bankAccount         String? // which account rent flows into
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user                 User                  @relation(fields: [userId], references: [id])
  properties           Property[]
  incomes              Income[]
  expenses             Expense[]
  deposits             Deposit[]
  maintenanceRequests  MaintenanceRequest[]
  maintenanceSchedules MaintenanceSchedule[]
  paintSpecs           PaintSpec[]
  flooringSpecs        FlooringSpec[]
  countertopSpecs      CountertopSpec[]
  fixtures             Fixture[]
  appliances           Appliance[]
  backsplashSpecs      BacksplashSpec[]
  exteriorFeatures     ExteriorFeature[]

  @@index([userId])
}

model Property {
  id        String   @id @default(cuid())
  userId    String
  entityId  String
  name      String? // optional nickname, e.g. "The Maple St duplex"
  address1  String
  address2  String?
  city      String
  state     String // drives legal notice-period rules in v2
  zip       String
  yearBuilt Int? // drives lead-based-paint disclosure applicability (federal law: pre-1978 only); not auto-enforced, just surfaced as context
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity               Entity                @relation(fields: [entityId], references: [id])
  leases               Lease[]
  tenants              Tenant[]
  incomes              Income[]
  expenses             Expense[]
  deposits             Deposit[]
  maintenanceRequests  MaintenanceRequest[]
  maintenanceSchedules MaintenanceSchedule[]
  paintSpecs           PaintSpec[]
  flooringSpecs        FlooringSpec[]
  countertopSpecs      CountertopSpec[]
  fixtures             Fixture[]
  appliances           Appliance[]
  backsplashSpecs      BacksplashSpec[]
  exteriorFeatures     ExteriorFeature[]

  @@index([userId])
  @@index([entityId])
}

enum TenantApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A Tenant record starts life as an application to a specific property —
// applicants apply for the property they're interested in, not "a tenancy
// in general." Only once the landlord approves does a Tenant get linked to
// a Lease (via LeaseTenant, which carries the per-lease role). Rejected
// applicants keep their record for history; they just never get a lease link.
model Tenant {
  id                String                  @id @default(cuid())
  userId            String
  propertyId        String
  applicationStatus TenantApplicationStatus @default(PENDING)
  firstName         String
  lastName          String
  phone             String?
  email             String?
  dateOfBirth       DateTime?

  idVerified            Boolean   @default(false)
  creditCheckStatus     String?
  creditCheckDate       DateTime?
  backgroundCheckStatus String?
  backgroundCheckDate   DateTime?

  employer         String?
  employmentStatus String?
  monthlyIncome    Decimal? @db.Decimal(10, 2)

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Renter's insurance lives on the tenant, not the landlord Insurance module (v2).
  rentersInsuranceInsurer                   String?
  rentersInsurancePolicyNumber              String?
  rentersInsuranceCoverageAmount            Decimal?  @db.Decimal(10, 2)
  rentersInsuranceExpirationDate            DateTime?
  rentersInsuranceLandlordAdditionalInsured Boolean?
  rentersInsuranceCertificateOnFile         Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id])
  property            Property             @relation(fields: [propertyId], references: [id])
  leaseTenants        LeaseTenant[]
  maintenanceRequests MaintenanceRequest[]
  documents           TenantDocument[]
  occupants           Occupant[]
  pets                Pet[]
  vehicles            Vehicle[]

  @@index([userId])
  @@index([propertyId])
}

enum TenantDocumentCategory {
  CREDIT_REPORT
  BACKGROUND_CHECK
  INCOME_VERIFICATION
  ID
}

// Screening/ID documents (credit report, background check, income proof,
// ID image) — a bucket per category since a tenant can reasonably have more
// than one (e.g. two pay stubs), matching CLAUDE.md's "additional documents"
// note. R2 object key only, same private-bucket/presigned-URL pattern as
// Lease.documentKey — never a stored public link.
model TenantDocument {
  id          String                 @id @default(cuid())
  tenantId    String
  category    TenantDocumentCategory
  fileName    String
  documentKey String
  createdAt   DateTime               @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  MONTH_TO_MONTH
  TERMINATED
}

// v1 fields (dates, rent, deposit, late fee, pet policy) still hold the key
// terms regardless of whether the lease builder is used. leaseClauses is the
// v2 clause-library-driven body of a generated lease document.
model Lease {
  id         String @id @default(cuid())
  userId     String
  propertyId String

  startDate DateTime
  endDate   DateTime?

  monthlyRent           Decimal  @db.Decimal(10, 2)
  securityDepositAmount Decimal? @db.Decimal(10, 2)

  lateFeeAmount    Decimal? @db.Decimal(10, 2)
  lateFeeGraceDays Int?

  petPolicy     Boolean  @default(false)
  petRentAmount Decimal? @db.Decimal(10, 2)

  // Minimum renter's-insurance liability coverage the lease requires Tenant to carry, backing the
  // {{tenant_insurance_minimum}} clause variable. Null means no minimum is required.
  tenantInsuranceMinimumCoverage Decimal? @db.Decimal(10, 2)

  // What the lease promises tenants, e.g. "3% max annually" — free text since caps vary in phrasing.
  renewalRentIncreaseCap String?

  notes  String?
  status LeaseStatus @default(ACTIVE)

  // R2 object key for the uploaded lease PDF. Bucket is private — downloads
  // go through a short-lived presigned URL generated on demand, never a
  // stored public URL.
  documentKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id])
  leaseTenants LeaseTenant[]
  incomes      Income[]
  deposits     Deposit[]
  leaseClauses LeaseClause[]
  attachments  LeaseAttachment[]

  @@index([userId])
  @@index([propertyId])
}

// The landlord's personal clause library — scoped by userId only, not
// property/entity, same reasoning as Vendor: one library reused across every
// lease. bodyText is stored and reproduced verbatim (Taylor's lesson:
// magistrates want the exact clause language, not a summary).
// group is a plain string validated against CLAUSE_GROUPS (backend/src/lib/clauseGroups.js), not
// a Prisma enum — Taylor wants the group list itself easy to rename/reorder later without a
// migration (an enum value rename already needed a hand-written migration once, for
// ExpenseCategory.LANDSCAPING). sectionNumber deliberately does not exist here: numbering is
// computed at read time from a lease clause's group + attach order, never typed by anyone.
model Clause {
  id        String   @id @default(cuid())
  userId    String
  title     String
  bodyText  String
  group     String
  // Two-letter state code (e.g. "CO") this clause's language is specific to, or null if it's
  // generic/universal. Filters the library view and "Add my default clauses" by the lease's
  // property state — not a Legal Tracker notice-period/deadline engine, just a content tag.
  state     String?
  // "Add my default clauses" (leases.routes.js) attaches every Clause with
  // isDefault: true in one action, instead of the landlord attaching their
  // usual set by hand on every new lease.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  leaseClauses LeaseClause[]

  @@index([userId])
}

// Marks a provided/locked template (clauseTemplates.js — not a DB row) as
// one of this landlord's defaults, without requiring them to copy it into
// their own editable Clause first. Keeps the "no drift from the shipped
// wording" guarantee: "Add my default clauses" resolves this row's
// templateId back to the static list at attach time, same as attaching a
// template manually.
model DefaultClauseTemplate {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, templateId])
  @@index([userId])
}

// A clause attached to one specific lease — a SNAPSHOT copy of the library
// Clause's (or a static template's) fields at attach time, not a live
// reference. Once a lease is generated (and potentially signed, potentially
// the document Taylor relies on in court), editing the master library clause
// later must never silently rewrite what a past lease says. sourceClauseId/
// sourceTemplateId are kept only for traceability (a "Provided" badge in the
// UI) — sourceTemplateId has no FK since templates aren't DB rows, they're
// the static list in clauseTemplates.js.
model LeaseClause {
  id               String  @id @default(cuid())
  leaseId          String
  sourceClauseId   String?
  sourceTemplateId String?

  title    String
  bodyText String
  group    String
  order    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lease        Lease   @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  sourceClause Clause? @relation(fields: [sourceClauseId], references: [id], onDelete: SetNull)

  @@index([leaseId])
  @@index([sourceClauseId])
}

// Supporting documents attached to a lease beyond the generated lease PDF itself — HOA rules,
// a rules addendum, or any other reference document a landlord wants bundled with the lease.
// Free-text category (not an enum, unlike TenantDocumentCategory) since these are open-ended,
// landlord-defined attachments rather than a fixed set of screening-document types. Same
// private-bucket/presigned-URL R2 pattern as every other document model in this app.
model LeaseAttachment {
  id          String   @id @default(cuid())
  leaseId     String
  category    String
  fileName    String
  documentKey String
  createdAt   DateTime @default(now())

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([leaseId])
}

enum LeaseTenantRole {
  PRIMARY
  CO_TENANT
  GUARANTOR
}

model LeaseTenant {
  id       String          @id @default(cuid())
  leaseId  String
  tenantId String
  role     LeaseTenantRole

  lease  Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([leaseId, tenantId])
  @@index([leaseId])
  @@index([tenantId])
}

// Anyone living at the property who isn't on the lease as a tenant (kids,
// an aging parent, etc.) — an individual record per person, not just a
// headcount. Replaces the old Lease.nonLeaseOccupantCount bare integer.
//
// Linked to a Tenant, not a Lease. A Lease is per-term paperwork that ends
// when a tenant moves; a Tenant persists across that move. Attaching an
// existing Tenant to a new Lease (via LeaseTenant) should bring their
// occupants/pets/vehicles along automatically, not require recreating them —
// which only works if the link points at the thing that doesn't change.
// With co-tenants, one tenant is picked as the anchor (defaults to whoever's
// Primary on the lease, app-layer only — still just a pointer, not a claim
// about real-world ownership).
model Occupant {
  id     String @id @default(cuid())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tenantId String
  name     String
  age      Int?
  phone    String?
  email    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Pet {
  id     String @id @default(cuid())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tenantId String
  type     String // cat, dog, bird, etc. — free text, no fixed list, same approach as Vendor.trade
  breed    String?
  name     String?
  license  String?
  age      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Vehicle {
  id     String @id @default(cuid())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tenantId     String
  make         String?
  model        String?
  year         Int?
  color        String?
  licensePlate String?
  state        String?
  vin          String?
  parkingSpot  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum IncomeCategory {
  RENT
  LATE_FEE
  PET_RENT
  DEPOSIT
  OTHER
}

// v1 rent tracking is a simple ledger: log payments as received. "Expected vs
// collected" is a comparison computed against Lease.monthlyRent, not a stored
// schedule — no recurring-charge engine until v2.
model Income {
  id         String         @id @default(cuid())
  userId     String
  entityId   String
  propertyId String
  leaseId    String?
  category   IncomeCategory
  amount     Decimal        @db.Decimal(10, 2)
  date       DateTime
  method     String? // free text, e.g. "check", "cash", "bank transfer"
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  entity    Entity           @relation(fields: [entityId], references: [id])
  property  Property         @relation(fields: [propertyId], references: [id])
  lease     Lease?           @relation(fields: [leaseId], references: [id])
  documents IncomeDocument[]

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
  @@index([leaseId])
}

// Receipts / proof of payment (e.g. a bank transfer screenshot) — a flat
// list per record, no categories needed unlike TenantDocument. Same
// private-bucket/presigned-URL R2 pattern used throughout.
model IncomeDocument {
  id          String   @id @default(cuid())
  incomeId    String
  fileName    String
  documentKey String
  createdAt   DateTime @default(now())

  income Income @relation(fields: [incomeId], references: [id], onDelete: Cascade)

  @@index([incomeId])
}

// REPAIRS (fixing something broken) and MAINTENANCE (routine/preventive upkeep)
// are kept as separate categories — real distinction in how Taylor tracks spend,
// not just code-vs-reality drift.
// IMPROVEMENT is distinct from REPAIRS — the real IRS distinction (a repair is
// deducted the year it's paid, a capital improvement is depreciated over its
// useful life on Schedule E), not just a bookkeeping preference. Property
// Specs' Flooring/Countertop/Backsplash cost-linking (Expense.flooringSpecs
// etc. below) exists mainly for this category, though nothing enforces the
// pairing — any category can be linked from a spec item if it fits.
enum ExpenseCategory {
  MORTGAGE
  UTILITIES
  REPAIRS
  MAINTENANCE
  LANDSCAPING
  INSURANCE_PREMIUM
  IMPROVEMENT
  TAX
  LEGAL
  OTHER
}

// Expenses flow to the owning Entity's books — entityId is derived server-side
// from property.entityId at creation, never trusted from the client.
model Expense {
  id         String          @id @default(cuid())
  userId     String
  entityId   String
  propertyId String
  category   ExpenseCategory
  amount     Decimal         @db.Decimal(10, 2)
  date       DateTime
  payee      String?
  method     String? // free text, e.g. "check", "cash", "bank transfer"
  // Expenses are accounts-payable-ish — a bill can be logged before it's
  // paid. Defaults true since most entries are logged at the moment of
  // payment; uncheck for "billed, not paid yet". Income has no equivalent —
  // it's only ever logged once money is actually received.
  paid       Boolean         @default(true)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  entity          Entity            @relation(fields: [entityId], references: [id])
  property        Property          @relation(fields: [propertyId], references: [id])
  documents       ExpenseDocument[]
  flooringSpecs   FlooringSpec[]
  countertopSpecs CountertopSpec[]
  backsplashSpecs BacksplashSpec[]

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
}

model ExpenseDocument {
  id          String   @id @default(cuid())
  expenseId   String
  fileName    String
  documentKey String
  createdAt   DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

enum DepositType {
  SECURITY
  PET
}

enum DepositStatus {
  HELD
  PARTIALLY_RETURNED
  FULLY_RETURNED
  FORFEITED
}

// Separate from Lease.securityDepositAmount (the lease-term promise) — this is
// the actual ledger of what's held, where, and what happened to it at move-out.
// A lease can hold more than one deposit (e.g. security + pet), each tracked
// independently — @@unique([leaseId, type]) allows at most one per type.
model Deposit {
  id             String        @id @default(cuid())
  userId         String
  entityId       String
  propertyId     String
  leaseId        String
  type           DepositType
  amountHeld     Decimal       @db.Decimal(10, 2)
  dateReceived   DateTime
  storageMethod  String? // e.g. "escrow account"
  status         DepositStatus @default(HELD)
  returnedAmount Decimal?      @db.Decimal(10, 2)
  returnedDate   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  entity     Entity             @relation(fields: [entityId], references: [id])
  property   Property           @relation(fields: [propertyId], references: [id])
  lease      Lease              @relation(fields: [leaseId], references: [id])
  deductions DepositDeduction[]

  @@unique([leaseId, type])
  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
}

model DepositDeduction {
  id          String   @id @default(cuid())
  depositId   String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  deposit Deposit @relation(fields: [depositId], references: [id], onDelete: Cascade)

  @@index([depositId])
}

// The vendor directory. Scoped by userId only, not property/entity — one
// vendor (e.g. a plumber) can service properties across multiple entities.
// No stored "cost history" field: it's derived by querying MaintenanceRequest
// rows for this vendor, same computed-not-stored approach as Finances'
// "expected vs collected."
model Vendor {
  id        String   @id @default(cuid())
  userId    String
  name      String
  trade     String? // free text — plumber, electrician, HVAC, etc. No fixed list yet.
  phone     String?
  email     String?
  preferred Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id])
  maintenanceRequests  MaintenanceRequest[]
  maintenanceSchedules MaintenanceSchedule[]
  appliances           Appliance[]

  @@index([userId])
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

// A "repair" is just a MaintenanceRequest — something reactive/ad-hoc, tracked
// through OPEN -> IN_PROGRESS -> CLOSED. Preventive/recurring work lives in
// MaintenanceSchedule instead. Deliberately not linked to Expense — actualCost
// here is descriptive only; Taylor logs a matching Expense by hand if wanted,
// per the same manual-ledger, no-automation stance as the rest of Finances.
// The 7 spec-link fields are real typed FKs, not a generic "linkedType +
// linkedId" pointer, deliberately — consistent with how this app already
// handles this tradeoff elsewhere (Occupant/Pet/Vehicle link straight to
// Tenant, not through a polymorphic reference). Sparser schema in exchange
// for real referential integrity and simple queries, the right tradeoff at
// this app's scale. Any Property Specs category can have real, trackable
// upkeep (touch-up paint, resealing a countertop, servicing a furnace) —
// Taylor's call after discussing whether to scope this to just
// Appliance/Fixture (2026-08-16): all 7 or none, not an arbitrary subset.
model MaintenanceRequest {
  id         String  @id @default(cuid())
  userId     String
  entityId   String
  propertyId String
  tenantId   String? // only set if an actual Tenant record reported it
  vendorId   String? // assigned once a vendor is picked

  paintSpecId       String?
  flooringSpecId    String?
  countertopSpecId  String?
  fixtureId         String?
  applianceId       String?
  backsplashSpecId  String?
  exteriorFeatureId String?

  title        String
  description  String?
  reportedBy   String? // free text — landlord, tenant name, neighbor, etc.
  reportedDate DateTime @default(now())

  status        MaintenanceStatus @default(OPEN)
  estimatedCost Decimal?          @db.Decimal(10, 2)
  actualCost    Decimal?          @db.Decimal(10, 2)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity          Entity                    @relation(fields: [entityId], references: [id])
  property        Property                  @relation(fields: [propertyId], references: [id])
  tenant          Tenant?                   @relation(fields: [tenantId], references: [id])
  vendor          Vendor?                   @relation(fields: [vendorId], references: [id])
  paintSpec       PaintSpec?                @relation(fields: [paintSpecId], references: [id])
  flooringSpec    FlooringSpec?             @relation(fields: [flooringSpecId], references: [id])
  countertopSpec  CountertopSpec?           @relation(fields: [countertopSpecId], references: [id])
  fixture         Fixture?                  @relation(fields: [fixtureId], references: [id])
  appliance       Appliance?                @relation(fields: [applianceId], references: [id])
  backsplashSpec  BacksplashSpec?           @relation(fields: [backsplashSpecId], references: [id])
  exteriorFeature ExteriorFeature?          @relation(fields: [exteriorFeatureId], references: [id])
  statusChanges   MaintenanceStatusChange[]
  user            User                      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([vendorId])
  @@index([paintSpecId])
  @@index([flooringSpecId])
  @@index([countertopSpecId])
  @@index([fixtureId])
  @@index([applianceId])
  @@index([backsplashSpecId])
  @@index([exteriorFeatureId])
}

// The audit trail Manora's design explicitly calls out as a differentiator —
// every status change timestamped, surfaced to the user. Auto-inserted by the
// route (on create, and on update whenever status actually changes), not a
// client-writable sub-resource. No changedBy field yet: v1 has exactly one
// possible actor (the landlord), so it'd be redundant with the parent's
// userId — add it once v2's contractor/tenant portals introduce other actors.
model MaintenanceStatusChange {
  id                   String             @id @default(cuid())
  maintenanceRequestId String
  fromStatus           MaintenanceStatus?
  toStatus             MaintenanceStatus
  changedAt            DateTime           @default(now())
  note                 String?

  maintenanceRequest MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)

  @@index([maintenanceRequestId])
}

// Preventive schedule: interval + last done -> next due. "Auto-alert when
// overdue" is a computed `overdue` flag in the API response (nextDueDate in
// the past) — no notification system exists yet, same no-automation stance
// as elsewhere in v1. Landscaping service is just a row here with a vendorId
// set, not a separate model.
model MaintenanceSchedule {
  id         String  @id @default(cuid())
  userId     String
  entityId   String
  propertyId String
  vendorId   String?

  paintSpecId       String?
  flooringSpecId    String?
  countertopSpecId  String?
  fixtureId         String?
  applianceId       String?
  backsplashSpecId  String?
  exteriorFeatureId String?

  title        String
  description  String?
  intervalDays Int
  lastDoneDate DateTime?
  nextDueDate  DateTime?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity          Entity                          @relation(fields: [entityId], references: [id])
  property        Property                        @relation(fields: [propertyId], references: [id])
  vendor          Vendor?                         @relation(fields: [vendorId], references: [id])
  user            User                            @relation(fields: [userId], references: [id])
  completions     MaintenanceScheduleCompletion[]
  paintSpec       PaintSpec?                      @relation(fields: [paintSpecId], references: [id])
  flooringSpec    FlooringSpec?                   @relation(fields: [flooringSpecId], references: [id])
  countertopSpec  CountertopSpec?                 @relation(fields: [countertopSpecId], references: [id])
  fixture         Fixture?                        @relation(fields: [fixtureId], references: [id])
  appliance       Appliance?                      @relation(fields: [applianceId], references: [id])
  backsplashSpec  BacksplashSpec?                 @relation(fields: [backsplashSpecId], references: [id])
  exteriorFeature ExteriorFeature?                @relation(fields: [exteriorFeatureId], references: [id])

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
  @@index([vendorId])
  @@index([paintSpecId])
  @@index([flooringSpecId])
  @@index([countertopSpecId])
  @@index([fixtureId])
  @@index([applianceId])
  @@index([backsplashSpecId])
  @@index([exteriorFeatureId])
}

// One row per "mark done" action — same audit-trail idea as
// MaintenanceStatusChange for requests. mark-done overwrites
// lastDoneDate/nextDueDate on the schedule itself (needed for the overdue
// check), but without this the prior completion dates would be lost.
model MaintenanceScheduleCompletion {
  id                    String   @id @default(cuid())
  maintenanceScheduleId String
  completedDate         DateTime
  createdAt             DateTime @default(now())

  maintenanceSchedule MaintenanceSchedule @relation(fields: [maintenanceScheduleId], references: [id], onDelete: Cascade)

  @@index([maintenanceScheduleId])
}

// Property Specs (v2) — dual "by room" (primary) / "by category" (secondary) view over the
// same records, per CLAUDE.md's UI principles. No separate Room model: `location` is free
// text (same convention as Vendor.trade/Pet.type for open-ended domains), grouped
// case-insensitively client-side for the room view — items with no location land in an
// "Unassigned" bucket there. Breadth-first pass (Taylor's call, 2026-08-16): core fields per
// category now; deeper fields (Flooring's SKU/dye lot/install method, Appliance's
// parts-replaced/service-history audit trail, Fixture's 5 type-specific field sets) are
// deliberately deferred, addable later without breaking this schema.

model PaintSpec {
  id         String @id @default(cuid())
  userId     String
  entityId   String
  propertyId String

  location               String?
  brand                  String?
  colorName              String?
  colorCode              String?
  sheen                  String?
  base                   String?
  formula                String?
  gallonsUsed            Decimal?  @db.Decimal(6, 2)
  datePainted            DateTime?
  paintedBy              String?
  touchUpStorageLocation String? // where leftover paint is stored — Taylor's lesson: always note this, saves you at tenant turnover
  notes                  String?
  active                 Boolean   @default(true)
  retiredAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity               Entity                @relation(fields: [entityId], references: [id])
  property             Property              @relation(fields: [propertyId], references: [id])
  maintenanceRequests  MaintenanceRequest[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
}

model FlooringSpec {
  id         String @id @default(cuid())
  userId     String
  entityId   String
  propertyId String

  location                String?
  brand                   String?
  productName             String?
  type                    String? // LVP, tile, carpet, hardwood — free text, no fixed list
  sqFtCovered             Decimal?  @db.Decimal(8, 2)
  boxesInstalled          Int?
  boxesLeftover           Int? // lowStock is computed from this on every response, not stored
  leftoverStorageLocation String?
  installedBy             String?
  installDate             DateTime?
  expenseId               String? // the real Expense that paid for this — no separate cost field to drift from it
  warranty                String?
  notes                   String?
  active                  Boolean   @default(true)
  retiredAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity               Entity                @relation(fields: [entityId], references: [id])
  property             Property              @relation(fields: [propertyId], references: [id])
  expense              Expense?              @relation(fields: [expenseId], references: [id])
  maintenanceRequests  MaintenanceRequest[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
  @@index([expenseId])
}

model CountertopSpec {
  id         String @id @default(cuid())
  userId     String
  entityId   String
  propertyId String

  location    String?
  brand       String?
  productName String?
  material    String? // quartz, granite, cultured marble, laminate — free text
  sqFt        Decimal?  @db.Decimal(8, 2)
  installedBy String?
  installDate DateTime?
  expenseId   String? // the real Expense that paid for this — no separate cost field to drift from it
  warranty    String?
  notes       String?
  active      Boolean   @default(true)
  retiredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity               Entity                @relation(fields: [entityId], references: [id])
  property             Property              @relation(fields: [propertyId], references: [id])
  expense              Expense?              @relation(fields: [expenseId], references: [id])
  maintenanceRequests  MaintenanceRequest[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
  @@index([expenseId])
}

// Collapses CLAUDE.md's 5 fixture sub-types (sinks, faucets, showers/tubs, toilets, hardware)
// into one model with a discriminator enum, rather than 5 separate models, for this
// breadth-first pass. Type-specific fields (GPF, rough-in, cartridge part #, recaulk
// schedule, center-to-center, etc.) live in `notes` for now.
enum FixtureType {
  SINK
  FAUCET
  SHOWER_TUB
  TOILET
  HARDWARE
}

model Fixture {
  id         String @id @default(cuid())
  userId     String
  entityId   String
  propertyId String

  location    String?
  fixtureType FixtureType
  brand       String?
  model       String?
  finish      String? // critical for matching replacements — store it
  warranty    String?
  notes       String?
  active      Boolean     @default(true)
  retiredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity               Entity                @relation(fields: [entityId], references: [id])
  property             Property              @relation(fields: [propertyId], references: [id])
  maintenanceRequests  MaintenanceRequest[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
}

model Appliance {
  id         String @id @default(cuid())
  userId     String
  entityId   String
  propertyId String

  location                String?
  make                    String?
  model                   String?
  year                    Int?
  serialNumber            String?
  warrantyExpiration      DateTime? // warrantyExpiringSoon is computed from this on every response, not stored
  maintenanceIntervalDays Int?
  lastServiceDate         DateTime?
  filterSize              String?
  preferredVendorId       String?
  notes                   String?
  active                  Boolean   @default(true)
  retiredAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity               Entity                @relation(fields: [entityId], references: [id])
  property             Property              @relation(fields: [propertyId], references: [id])
  preferredVendor      Vendor?               @relation(fields: [preferredVendorId], references: [id])
  maintenanceRequests  MaintenanceRequest[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
  @@index([preferredVendorId])
}

model BacksplashSpec {
  id         String @id @default(cuid())
  userId     String
  entityId   String
  propertyId String

  location         String?
  brand            String?
  productName      String?
  material         String?
  tileSize         String?
  groutColor       String?
  groutBrand       String?
  spareTilesOnHand Int?
  expenseId        String? // the real Expense that paid for this — no separate cost field to drift from it
  notes            String?
  active           Boolean   @default(true)
  retiredAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity               Entity                @relation(fields: [entityId], references: [id])
  property             Property              @relation(fields: [propertyId], references: [id])
  expense              Expense?              @relation(fields: [expenseId], references: [id])
  maintenanceRequests  MaintenanceRequest[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
  @@index([expenseId])
}

// Landscaping recurring service is tracked in Maintenance as a MaintenanceSchedule row
// (per the existing decision) — the fields here are the descriptive "what's on the
// property" side (trees, bushes, lawn) plus last-serviced dates, not a scheduler.
model ExteriorFeature {
  id         String @id @default(cuid())
  userId     String
  entityId   String
  propertyId String

  location           String? // e.g. "Front yard", "Backyard" — optional, same free-text convention as everywhere else
  name               String? // e.g. "Oak tree", "Front lawn"
  approxAge          Int? // years
  size               String? // free text, e.g. "20 ft tall" — no fixed unit
  lastTrimmedDate    DateTime?
  lastTreatedDate    DateTime?
  lastFertilizedDate DateTime?
  notes              String?
  active             Boolean   @default(true)
  retiredAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity               Entity                @relation(fields: [entityId], references: [id])
  property             Property              @relation(fields: [propertyId], references: [id])
  maintenanceRequests  MaintenanceRequest[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
}
