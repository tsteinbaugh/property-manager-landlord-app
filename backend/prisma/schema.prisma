// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Roles are stored as plain strings ("landlord", "system_admin"), not an enum,
// per CLAUDE.md RBAC notes — ROLE_GRANTS maps strings to permissions in app code.
model User {
  id        String   @id @default(cuid())
  clerkId   String?  @unique
  email     String   @unique
  name      String?
  role      String   @default("landlord")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities Entity[]
  tenants  Tenant[]
}

enum EntityType {
  LLC
  S_CORP
  PERSONAL
  OTHER
}

// Every property is owned by an Entity, never directly by a User.
// "Self / Personal" (entityType = PERSONAL) is a valid entity for landlords without an LLC.
model Entity {
  id                  String     @id @default(cuid())
  userId              String
  legalName           String
  entityType          EntityType
  stateOfFormation    String?
  ein                 String? // encrypted at rest at the app layer
  registeredAgent     String?
  formationDate       DateTime?
  annualReportDueDate DateTime? // reminder fires 60 days before this date
  bankAccount         String? // which account rent flows into
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  properties Property[]
  incomes    Income[]
  expenses   Expense[]
  deposits   Deposit[]

  @@index([userId])
}

model Property {
  id        String   @id @default(cuid())
  userId    String
  entityId  String
  name      String? // optional nickname, e.g. "The Maple St duplex"
  address1  String
  address2  String?
  city      String
  state     String // drives legal notice-period rules in v2
  zip       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity   Entity    @relation(fields: [entityId], references: [id])
  leases   Lease[]
  tenants  Tenant[]
  incomes  Income[]
  expenses Expense[]
  deposits Deposit[]

  @@index([userId])
  @@index([entityId])
}

enum TenantApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A Tenant record starts life as an application to a specific property —
// applicants apply for the property they're interested in, not "a tenancy
// in general." Only once the landlord approves does a Tenant get linked to
// a Lease (via LeaseTenant, which carries the per-lease role). Rejected
// applicants keep their record for history; they just never get a lease link.
model Tenant {
  id                String                  @id @default(cuid())
  userId            String
  propertyId        String
  applicationStatus TenantApplicationStatus @default(PENDING)
  name              String
  phone             String?
  email             String?
  dateOfBirth       DateTime?

  idVerified        Boolean   @default(false)
  creditCheckStatus String?
  creditCheckDate   DateTime?

  employer         String?
  employmentStatus String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Renter's insurance lives on the tenant, not the landlord Insurance module (v2).
  rentersInsuranceInsurer                   String?
  rentersInsurancePolicyNumber              String?
  rentersInsuranceCoverageAmount            Decimal?  @db.Decimal(10, 2)
  rentersInsuranceExpirationDate            DateTime?
  rentersInsuranceLandlordAdditionalInsured Boolean?
  rentersInsuranceCertificateOnFile         Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  property     Property      @relation(fields: [propertyId], references: [id])
  leaseTenants LeaseTenant[]

  @@index([userId])
  @@index([propertyId])
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  MONTH_TO_MONTH
  TERMINATED
}

// v1 is upload PDF + key fields only — no clause library / lease builder until v2.
model Lease {
  id         String @id @default(cuid())
  userId     String
  propertyId String

  startDate DateTime
  endDate   DateTime?

  monthlyRent           Decimal  @db.Decimal(10, 2)
  securityDepositAmount Decimal? @db.Decimal(10, 2)

  lateFeeAmount    Decimal? @db.Decimal(10, 2)
  lateFeeGraceDays Int?

  petPolicy     Boolean  @default(false)
  petRentAmount Decimal? @db.Decimal(10, 2)

  // What the lease promises tenants, e.g. "3% max annually" — free text since caps vary in phrasing.
  renewalRentIncreaseCap String?

  // Non-lease occupants (children, aging parent) — occupancy count only, no separate profiles in v1.
  nonLeaseOccupantCount Int?

  notes  String?
  status LeaseStatus @default(ACTIVE)

  // Set once Cloudflare R2 storage is wired up; nothing writes here yet.
  documentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id])
  leaseTenants LeaseTenant[]
  incomes      Income[]
  deposits     Deposit[]

  @@index([userId])
  @@index([propertyId])
}

enum LeaseTenantRole {
  PRIMARY
  CO_TENANT
  GUARANTOR
}

model LeaseTenant {
  id       String          @id @default(cuid())
  leaseId  String
  tenantId String
  role     LeaseTenantRole

  lease  Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([leaseId, tenantId])
  @@index([leaseId])
  @@index([tenantId])
}

enum IncomeCategory {
  RENT
  LATE_FEE
  PET_RENT
  DEPOSIT
  OTHER
}

// v1 rent tracking is a simple ledger: log payments as received. "Expected vs
// collected" is a comparison computed against Lease.monthlyRent, not a stored
// schedule — no recurring-charge engine until v2.
model Income {
  id         String         @id @default(cuid())
  userId     String
  entityId   String
  propertyId String
  leaseId    String?
  category   IncomeCategory
  amount     Decimal        @db.Decimal(10, 2)
  date       DateTime
  method     String? // free text, e.g. "check", "cash", "bank transfer"
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  entity   Entity   @relation(fields: [entityId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  lease    Lease?   @relation(fields: [leaseId], references: [id])

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
  @@index([leaseId])
}

// REPAIRS (fixing something broken) and MAINTENANCE (routine/preventive upkeep)
// are kept as separate categories — real distinction in how Taylor tracks spend,
// not just code-vs-reality drift.
enum ExpenseCategory {
  MORTGAGE
  UTILITIES
  REPAIRS
  MAINTENANCE
  LANDSCAPING
  INSURANCE_PREMIUM
  TAX
  LEGAL
  OTHER
}

// Expenses flow to the owning Entity's books — entityId is derived server-side
// from property.entityId at creation, never trusted from the client.
model Expense {
  id         String          @id @default(cuid())
  userId     String
  entityId   String
  propertyId String
  category   ExpenseCategory
  amount     Decimal         @db.Decimal(10, 2)
  date       DateTime
  payee      String?
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  entity   Entity   @relation(fields: [entityId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
}

enum DepositType {
  SECURITY
  PET
}

enum DepositStatus {
  HELD
  PARTIALLY_RETURNED
  FULLY_RETURNED
  FORFEITED
}

// Separate from Lease.securityDepositAmount (the lease-term promise) — this is
// the actual ledger of what's held, where, and what happened to it at move-out.
// A lease can hold more than one deposit (e.g. security + pet), each tracked
// independently — @@unique([leaseId, type]) allows at most one per type.
model Deposit {
  id             String        @id @default(cuid())
  userId         String
  entityId       String
  propertyId     String
  leaseId        String
  type           DepositType
  amountHeld     Decimal       @db.Decimal(10, 2)
  dateReceived   DateTime
  storageMethod  String? // e.g. "escrow account"
  status         DepositStatus @default(HELD)
  returnedAmount Decimal?      @db.Decimal(10, 2)
  returnedDate   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  entity     Entity            @relation(fields: [entityId], references: [id])
  property   Property          @relation(fields: [propertyId], references: [id])
  lease      Lease             @relation(fields: [leaseId], references: [id])
  deductions DepositDeduction[]

  @@unique([leaseId, type])
  @@index([userId])
  @@index([entityId])
  @@index([propertyId])
}

model DepositDeduction {
  id          String   @id @default(cuid())
  depositId   String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  deposit Deposit @relation(fields: [depositId], references: [id], onDelete: Cascade)

  @@index([depositId])
}
