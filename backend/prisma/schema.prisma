datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SYSADMIN
  LANDLORD
  PROPERTY_MANAGER
  MAINTENANCE_TECH
  TENANT
  CLEANER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  TERMINATED
  ARCHIVED
}

enum AuthTokenKind {
  INVITE
  RESET_PASSWORD
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  passwordHash String
  baseRole     Role        @default(LANDLORD)
  status       UserStatus  @default(ACTIVE)
  isArchived   Boolean     @default(false)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  leases       Lease[]     @relation("UserLeases")
  authTokens   AuthToken[]

  
}

model Property {
  id          String   @id @default(cuid())
  name        String?
  address1    String
  city        String
  state       String
  postalCode  String
  isArchived  Boolean  @default(false)

  leases      Lease[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lease {
  id          String       @id @default(cuid())

  property    Property     @relation(fields: [propertyId], references: [id])
  propertyId  String

  landlord    User         @relation("UserLeases", fields: [landlordId], references: [id])
  landlordId  String

  // OPTIONAL lease display name
  tenantName  String?

  // REQUIRED: real tenant relationship
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])

  rentAmount  Int?         // <-- make optional; backend allows null
  status      LeaseStatus  @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  fileUrl          String?
  fileOriginalName String?
  fileMimeType     String?
  fileSize         Int?
}

model Tenant {
  id         String    @id @default(cuid())
  name       String
  email      String?
  phone      String?
  isArchived Boolean   @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  leases             Lease[]
  occupants          Occupant[]
  pets               Pet[]
  emergencyContacts  EmergencyContact[]
}

model Occupant {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String

  name       String
  relation   String?
  isArchived Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Pet {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String

  name       String
  type       String?
  breed      String?
  weightLb   Int?
  isArchived Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EmergencyContact {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String

  name       String
  phone      String?
  relation   String?
  email      String?
  isArchived Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuthToken {
  id        String        @id @default(cuid())
  token     String        @unique
  kind      AuthTokenKind
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
}