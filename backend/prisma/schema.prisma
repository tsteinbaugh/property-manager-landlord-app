datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SYSADMIN
  LANDLORD
  PROPERTY_MANAGER
  MAINTENANCE_TECH
  TENANT
  CLEANER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  TERMINATED
  ARCHIVED
}

enum AuthTokenKind {
  INVITE
  RESET_PASSWORD
}

enum HairColor {
  BLACK
  BROWN
  BLONDE
  RED
  GRAY
  WHITE
  DYED
  BALD
  UNKNOWN
}

enum EyeColor {
  BROWN
  BLUE
  GREEN
  HAZEL
  GRAY
  AMBER
  UNKNOWN
}

enum BodyBuild {
  SLIM
  AVERAGE
  ATHLETIC
  HEAVYSET
  UNKNOWN
}

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  baseRole     Role       @default(LANDLORD)
  status       UserStatus @default(ACTIVE)
  isArchived   Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  leases     Lease[]     @relation("UserLeases")
  authTokens AuthToken[]

  tenant Tenant?

  propertiesOwned   Property[] @relation("LandlordProperties")
  propertiesCreated Property[] @relation("PropertyCreatedBy")

  // Who created which tenants
  tenantsCreated Tenant[] @relation("TenantCreatedBy")

  // Who owns which tenants (landlord-level ownership)
  tenantsOwned Tenant[] @relation("LandlordTenants")

  //who created which leases
  leasesCreated Lease[] @relation("LeaseCreatedBy")

  //who created which occupants/pets/emergencyContacts/vehicles
  occupantsCreated         Occupant[]         @relation("OccupantCreatedBy")
  petsCreated              Pet[]              @relation("PetCreatedBy")
  emergencyContactsCreated EmergencyContact[] @relation("EmergencyContactCreatedBy")
  vehiclesCreated          Vehicle[]          @relation("VehicleCreatedBy")

  //who owns which occupants/pets/emergencyContacts/vehicles (landlord-level ownership)
  occupantsOwned         Occupant[]         @relation("LandlordOccupants")
  petsOwned              Pet[]              @relation("LandlordPets")
  emergencyContactsOwned EmergencyContact[] @relation("LandlordEmergencyContacts")
  vehiclesOwned          Vehicle[]          @relation("LandlordVehicles")

  //who created which users (self-relation)
  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  usersCreated User[]  @relation("UserCreatedBy")
}

model Property {
  id         String  @id @default(cuid())
  name       String?
  address1   String
  city       String
  state      String
  postalCode String
  bedrooms   Int?
  bathrooms  Int?
  sqft       Int?
  yearBuilt  Int?
  notes      String?

  isArchived Boolean @default(false)

  leases Lease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  landlordId String? // FK to User
  landlord   User?   @relation("LandlordProperties", fields: [landlordId], references: [id])

  createdById String?
  createdBy   User?   @relation("PropertyCreatedBy", fields: [createdById], references: [id])
}

model Lease {
  id String @id @default(cuid())

  property      Property? @relation(fields: [propertyId], references: [id])
  propertyId    String?
  propertyLabel String?

  leaseTenants LeaseTenant[]

  landlord   User   @relation("UserLeases", fields: [landlordId], references: [id])
  landlordId String

  rentAmount Int?
  status     LeaseStatus @default(DRAFT)
  startDate  DateTime?
  endDate    DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fileUrl          String?
  fileOriginalName String?
  fileMimeType     String?
  fileSize         Int?

  createdById String?
  createdBy   User?   @relation("LeaseCreatedBy", fields: [createdById], references: [id])
}

model Tenant {
  id           String     @id @default(cuid())
  name         String
  email        String?
  phone        String?
  age          Int?
  heightFeet   Int?
  heightInches Int?
  weight       Int?
  sex          Sex?       @default(UNKNOWN)
  hairColor    HairColor? @default(UNKNOWN)
  eyeColor     EyeColor   @default(UNKNOWN)
  bodyBuild    BodyBuild? @default(UNKNOWN)
  markings     String?
  occupation   String?
  income       Int?
  creditScore  Int?
  violations   String?
  notes        String?
  isArchived   Boolean    @default(false)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // OWNER landlord – who “owns/controls” this tenant in the app
  landlordId String?
  landlord   User?   @relation("LandlordTenants", fields: [landlordId], references: [id])

  // CREATOR – who originally created this row (landlord or sysadmin)
  createdById String?
  createdBy   User?   @relation("TenantCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaseTenants LeaseTenant[]

  //multi-tenant join links 
  occupantLinks         TenantOccupant[]
  petLinks              TenantPet[]
  emergencyContactLinks TenantEmergencyContact[]
  vehicleLinks          TenantVehicle[]
}

model LeaseTenant {
  id String @id @default(cuid())

  leaseId    String
  tenantId   String
  tenantName String?

  // Optional but useful metadata
  isPrimary Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?

  lease  Lease  @relation(fields: [leaseId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([leaseId, tenantId])
}

model Occupant {
  id       String  @id @default(cuid())

  name         String
  phone        String?
  email        String?
  relation     String?
  age          Int?
  heightFeet   Int?
  heightInches Int?
  weight       Int?
  sex          Sex?       @default(UNKNOWN)
  hairColor    HairColor? @default(UNKNOWN)
  eyeColor     EyeColor   @default(UNKNOWN)
  bodyBuild    BodyBuild? @default(UNKNOWN)
  markings     String?
  notes        String?
  violations   String?
  isArchived   Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OWNER landlord – whose portfolio this occupant belongs to
  landlordId String?
  landlord   User?   @relation("LandlordOccupants", fields: [landlordId], references: [id])

  // CREATOR – who actually created this occupant
  createdById String?
  createdBy   User?   @relation("OccupantCreatedBy", fields: [createdById], references: [id])

  //multi-tenant join links
  tenantLinks TenantOccupant[]
}

model Pet {
  id       String  @id @default(cuid())

  name       String
  type       String?
  breed      String?
  weightLb   Int?
  age        Int?
  license    String?
  notes      String?
  violations String?
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OWNER landlord
  landlordId String?
  landlord   User?   @relation("LandlordPets", fields: [landlordId], references: [id])

  // CREATOR
  createdById String?
  createdBy   User?   @relation("PetCreatedBy", fields: [createdById], references: [id])

  //multi-tenant join links 
  tenantLinks TenantPet[]
}

model EmergencyContact {
  id       String  @id @default(cuid())

  name       String
  phone      String?
  relation   String?
  email      String?
  address1   String?
  city       String?
  state      String?
  postalCode String?
  notes      String?
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OWNER landlord
  landlordId String?
  landlord   User?   @relation("LandlordEmergencyContacts", fields: [landlordId], references: [id])

  // CREATOR
  createdById String?
  createdBy   User?   @relation("EmergencyContactCreatedBy", fields: [createdById], references: [id])

  //multi-tenant join links 
  tenantLinks TenantEmergencyContact[]
}

model Vehicle {
  id       String  @id @default(cuid())

  make       String?
  model      String?
  year       Int?
  color      String?
  state      String?
  plate      String?
  permit     String?
  parking    String?
  notes      String?
  violations String?
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OWNER landlord
  landlordId String?
  landlord   User?   @relation("LandlordVehicles", fields: [landlordId], references: [id])

  // CREATOR
  createdById String?
  createdBy   User?   @relation("VehicleCreatedBy", fields: [createdById], references: [id])

  //multi-tenant join links 
  tenantLinks TenantVehicle[]
}

model AuthToken {
  id        String        @id @default(cuid())
  token     String        @unique
  kind      AuthTokenKind
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
}

model TenantOccupant {
  id         String @id @default(cuid())
  tenantId   String
  occupantId String

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  occupant Occupant @relation(fields: [occupantId], references: [id])

  @@unique([tenantId, occupantId])
}

model TenantPet {
  id       String @id @default(cuid())
  tenantId String
  petId    String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  pet    Pet    @relation(fields: [petId], references: [id])

  @@unique([tenantId, petId])
}

model TenantEmergencyContact {
  id                 String @id @default(cuid())
  tenantId           String
  emergencyContactId String

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  emergencyContact EmergencyContact @relation(fields: [emergencyContactId], references: [id])

  @@unique([tenantId, emergencyContactId])
}

model TenantVehicle {
  id        String @id @default(cuid())
  tenantId  String
  vehicleId String

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([tenantId, vehicleId])
}
