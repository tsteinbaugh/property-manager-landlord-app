model Lease {
  id String @id @default(cuid())

  property      Property? @relation(fields: [propertyId], references: [id])
  propertyId    String?
  propertyLabel String?

  leaseTenants LeaseTenant[]

  landlord   User   @relation("UserLeases", fields: [landlordId], references: [id])
  landlordId String

  rentAmount Int?
  status     LeaseStatus @default(DRAFT)
  startDate  DateTime?
  endDate    DateTime?
  leaseType  LeaseType @default(FIXED_TERM)
  notes      String?

  archivedAt      DateTime?
  archiveReason   String?
  archivedById    String?
  archivedBy      User? @relation("LeaseArchivedBy", fields: [archivedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents LeaseDocument[]

  createdById String?
  createdBy   User? @relation("LeaseCreatedBy", fields: [createdById], references: [id])
}

enum LeaseType {
  FIXED_TERM
  MONTH_TO_MONTH
}

model LeaseDocument {
  id String @id @default(cuid())

  lease   Lease   @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  leaseId String

  url          String
  originalName String
  mimeType     String?
  size         Int?

  createdAt DateTime @default(now())

  createdById String?
  createdBy   User? @relation("LeaseDocumentCreatedBy", fields: [createdById], references: [id])

  archivedAt    DateTime?
  archiveReason String?
  archivedById  String?
  archivedBy    User? @relation("LeaseDocumentArchivedBy", fields: [archivedById], references: [id])

  @@index([leaseId])
  @@index([createdById])
  @@index([archivedById])
  @@index([archivedAt])
}
