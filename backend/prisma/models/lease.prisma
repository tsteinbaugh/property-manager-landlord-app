model Lease {
  id String @id @default(cuid())

  property      Property? @relation(fields: [propertyId], references: [id])
  propertyId    String?
  propertyLabel String?

  leaseTenants LeaseTenant[]

  landlord   User   @relation("UserLeases", fields: [landlordId], references: [id])
  landlordId String

  rentAmountCents Int?
  startDate       DateTime?
  endDate         DateTime?
  leaseType       LeaseType @default(FIXED_TERM)

  rentDueDay       Int?
  gracePeriodDays  Int?
  noticePeriodDays Int?
  requiresAutoPay  Boolean @default(false)

  lateFeePolicyId String?
  lateFeePolicy   LateFeePolicy? @relation(fields: [lateFeePolicyId], references: [id])

  securityDepositAmountCents Int?
  depositHeldSince           DateTime?

  allocationOrder AllocationOrder?

  status       LeaseStatus        @default(DRAFT)
  statusReason LeaseStatusReason?
  statusNotes  String?

  notes String?

  archivedAt    DateTime?
  archiveReason String?
  archivedById  String?
  archivedBy    User?     @relation("LeaseArchivedBy", fields: [archivedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments LeaseAttachment[]

  createdById String?
  createdBy   User?   @relation("LeaseCreatedBy", fields: [createdById], references: [id])

  ledgerCharges  LedgerCharge[]
  ledgerPayments LedgerPayment[]

  visits       PropertyVisit[]
  legalNotices LegalNoticeDelivery[]

  @@index([propertyId])
  @@index([landlordId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

enum LeaseType {
  FIXED_TERM
  MONTH_TO_MONTH
}

model LeaseAttachment {
  id String @id @default(cuid())

  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  leaseId String

  url          String
  originalName String
  mimeType     String?
  size         Int?

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("LeaseAttachmentCreatedBy", fields: [createdById], references: [id])

  archivedAt    DateTime?
  archiveReason String?
  archivedById  String?
  archivedBy    User?     @relation("LeaseAttachmentArchivedBy", fields: [archivedById], references: [id])

  @@index([leaseId])
  @@index([createdById])
  @@index([archivedById])
  @@index([archivedAt])
}

enum LeaseStatusReason {
  EXPIRED
  NON_RENEWED
  NONPAYMENT
  LEASE_VIOLATION
  MUTUAL_AGREEMENT
  UNINHABITABLE
  PROPERTY_SOLD
  TENANT_REQUEST
  LANDLORD_REQUEST
  EVICTION
  OTHER
}

enum AllocationOrder {
  FEES_FIRST
  RENT_FIRST
  UTILITIES_FIRST
  CUSTOM
}
