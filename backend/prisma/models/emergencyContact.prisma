model EmergencyContact {
  id String @id @default(cuid())

  name       String
  phone      String
  email      String
  address1   String?
  address2   String?
  city       String?
  state      StateCode?
  postalCode String?
  relation   String?
  notes      String?

  archivedAt    DateTime?
  archiveReason String?
  archivedById  String?
  archivedBy    User?     @relation("EmergencyContactArchivedBy", fields: [archivedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OWNER landlord
  landlordId String?
  landlord   User?   @relation("LandlordEmergencyContacts", fields: [landlordId], references: [id])

  // CREATOR
  createdById String?
  createdBy   User?   @relation("EmergencyContactCreatedBy", fields: [createdById], references: [id])

  //multi-tenant join links 
  tenantLinks TenantEmergencyContact[]
}
