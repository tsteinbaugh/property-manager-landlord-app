model Tenant {
  id           String     @id @default(cuid())
  name         String
  email        String?
  phone        String?
  age          Int?
  heightFeet   Int?
  heightInches Int?
  weight       Int?
  sex          Sex?      
  hairColor    HairColor?
  eyeColor     EyeColor?
  bodyBuild    BodyBuild?
  markings     String?
  occupation   String?
  employer     String?
  income       Int?
  creditScore  Int?
  status       TenantStatus @default(DRAFT)
  notes        String?

  archivedAt   DateTime?
  archiveReason String?
  archivedById    String?
  archivedBy      User? @relation("TenantArchivedBy", fields: [archivedById], references: [id])    

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // OWNER landlord – who “owns/controls” this tenant in the app
  landlordId String?
  landlord   User?   @relation("LandlordTenants", fields: [landlordId], references: [id])

  // CREATOR – who originally created this row (landlord or sysadmin)
  createdById String?
  createdBy   User?   @relation("TenantCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments TenantAttachment[]

  leaseTenants LeaseTenant[]

  //multi-tenant join links 
  occupantLinks         TenantOccupant[]
  petLinks              TenantPet[]
  emergencyContactLinks TenantEmergencyContact[]
  vehicleLinks          TenantVehicle[]
}

model TenantAttachment {
  id String @id @default(cuid())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  url          String
  originalName String
  mimeType     String?
  size         Int?

  createdAt DateTime @default(now())
  createdById String?
  createdBy   User? @relation("TenantAttachmentCreatedBy", fields: [createdById], references: [id])

  archivedAt      DateTime?
  archiveReason   String?
  archivedById    String?
  archivedBy      User? @relation("TenantAttachmentArchivedBy", fields: [archivedById], references: [id])  

  @@index([tenantId])
  @@index([createdById])
  @@index([archivedById])
  @@index([archivedAt])  
}