model Tenant {
  id           String     @id @default(cuid())
  name         String
  email        String?
  phone        String?
  age          Int?
  heightFeet   Int?
  heightInches Int?
  weight       Int?
  sex          Sex?      
  hairColor    HairColor?
  eyeColor     EyeColor?
  bodyBuild    BodyBuild?
  markings     String?
  occupation   String?
  employer     String?
  income       Int?
  creditScore  Int?
  status       TenantStatus @default(DRAFT)
  notes        String?
  archivedAt   DateTime?
  archiveReason String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // OWNER landlord – who “owns/controls” this tenant in the app
  landlordId String?
  landlord   User?   @relation("LandlordTenants", fields: [landlordId], references: [id])

  // CREATOR – who originally created this row (landlord or sysadmin)
  createdById String?
  createdBy   User?   @relation("TenantCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaseTenants LeaseTenant[]

  //multi-tenant join links 
  occupantLinks         TenantOccupant[]
  petLinks              TenantPet[]
  emergencyContactLinks TenantEmergencyContact[]
  vehicleLinks          TenantVehicle[]
}