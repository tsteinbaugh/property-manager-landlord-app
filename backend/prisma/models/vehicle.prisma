model Vehicle {
  id       String  @id @default(cuid())

  make       String?
  model      String?
  year       Int?
  color      String?
  state      StateCode?
  plate      String?
  permit     String?
  parking    String?
  notes      String?

  archivedAt   DateTime?
  archiveReason String?
  archivedById    String?
  archivedBy      User? @relation("VehicleArchivedBy", fields: [archivedById], references: [id])    

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OWNER landlord
  landlordId String?
  landlord   User?   @relation("LandlordVehicles", fields: [landlordId], references: [id])

  // CREATOR
  createdById String?
  createdBy   User?   @relation("VehicleCreatedBy", fields: [createdById], references: [id])

  //multi-tenant join links 
  tenantLinks TenantVehicle[]
}

model AuthToken {
  id        String        @id @default(cuid())
  token     String        @unique
  kind      AuthTokenKind
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
}