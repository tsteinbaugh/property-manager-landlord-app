model Pet {
  id       String  @id @default(cuid())

  name       String
  type       String?
  breed      String?
  weightLb   Int?
  age        Int?
  license    String?
  notes      String?
  violations String?
  archivedAt   DateTime?
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OWNER landlord
  landlordId String?
  landlord   User?   @relation("LandlordPets", fields: [landlordId], references: [id])

  // CREATOR
  createdById String?
  createdBy   User?   @relation("PetCreatedBy", fields: [createdById], references: [id])

  //multi-tenant join links 
  tenantLinks TenantPet[]
}